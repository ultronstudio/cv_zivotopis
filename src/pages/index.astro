---
import { cv, siteUrl } from '../data/cv';

const canonical = `${siteUrl}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Choose the Czech or English version of Petr Vurm's CV. / Vyberte českou nebo anglickou verzi životopisu Petra Vurma."
    />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="cs" href={`${siteUrl}/cs/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/x-icon" href="https://petrvurm.cz/favicon.ico" />
    <title>CV | Petr Vurm</title>
    <style>
      :root {
        --primary: #00b7ef;
        --primary-dark: #0095b8;
        --text: #333;
        --muted: #6d7278;
        --bg: #f4f6f8;
        --paper: #fff;
      }

      * { box-sizing: border-box; }
      html, body { min-height: 100%; margin: 0; }
      body {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background: var(--bg);
        color: var(--text);
        font-family: Georgia, "Times New Roman", serif;
      }
      main {
        width: min(560px, 100%);
        background: var(--paper);
        border-top: 7px solid var(--primary);
        padding: 38px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
      }
      h1 { margin: 0 0 8px; font-size: 32px; }
      .role { margin: 0 0 30px; color: var(--muted); font-size: 18px; }
      .languages { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
      a {
        display: block;
        padding: 18px;
        border: 1px solid #d9dde1;
        border-radius: 7px;
        color: var(--text);
        text-decoration: none;
        transition: border-color .15s ease, box-shadow .15s ease;
      }
      a:hover, a.recommended {
        border-color: var(--primary);
        box-shadow: 0 0 0 2px rgba(0, 183, 239, 0.12);
      }
      a strong { display: block; color: var(--primary-dark); font-size: 18px; margin-bottom: 4px; }
      a span { color: var(--muted); font-family: Arial, sans-serif; font-size: 14px; }
      .hint { min-height: 20px; margin: 18px 0 0; color: var(--muted); font-family: Arial, sans-serif; font-size: 13px; }
      @media (max-width: 540px) {
        main { padding: 28px 22px; }
        .languages { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{cv.basics.name}</h1>
      <p class="role">{cv.basics.label}</p>
      <div class="languages">
        <a id="cs-link" href="/cs/" hreflang="cs" lang="cs">
          <strong>Česky</strong>
          <span>Životopis v češtině</span>
        </a>
        <a id="en-link" href="/en/" hreflang="en" lang="en">
          <strong>English</strong>
          <span>CV in English</span>
        </a>
      </div>
      <p id="language-hint" class="hint" aria-live="polite"></p>
    </main>

    <script is:inline>
      const prefersCzech = (navigator.languages || [navigator.language])
        .some((language) => typeof language === 'string' && language.toLowerCase().startsWith('cs'));
      const recommended = document.getElementById(prefersCzech ? 'cs-link' : 'en-link');
      recommended?.classList.add('recommended');
      document.getElementById('language-hint').textContent = prefersCzech
        ? 'Podle jazyka prohlížeče doporučujeme českou verzi.'
        : 'Based on your browser language, we recommend the English version.';
    </script>
  </body>
</html>
