---
import '../styles/style.css';
import { cv, siteUrl, t, type Locale } from '../data/cv';

const { locale } = Astro.props as { locale: Locale };
const meta = cv.meta[locale];
const canonical = `${siteUrl}/${locale}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: cv.basics.name,
  url: cv.basics.webHref,
  telephone: cv.basics.phoneHref,
  email: cv.basics.email,
  sameAs: [cv.basics.linkedinHref, cv.basics.webHref, cv.basics.githubHref],
  jobTitle: cv.basics.label,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="author" content={cv.basics.name} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="cs" href={`${siteUrl}/cs/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'cs' ? 'cs_CZ' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'cs' ? 'en_US' : 'cs_CZ'} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />

    <link rel="icon" type="image/x-icon" href="https://petrvurm.cz/favicon.ico" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{meta.title}</title>
  </head>

  <body>
    <div class="toolbar">
      <button type="button" id="printButton">
        <i class="fa-solid fa-print" aria-hidden="true"></i>
        <span>{t(cv.ui.print, locale)}</span>
      </button>

      <nav class="lang-switch" aria-label="Language">
        <a href="/cs/" hreflang="cs" lang="cs" class:list={{ active: locale === 'cs' }}>CZ</a>
        <a href="/en/" hreflang="en" lang="en" class:list={{ active: locale === 'en' }}>EN</a>
      </nav>
    </div>

    <main class="cv">
      <section class="page page-one">
        <header class="header">
          <h1>{cv.basics.name}</h1>
          <div class="place">{cv.basics.label}</div>

          <div class="contact-grid">
            <div class="contact-item">
              <i class="fa-solid fa-phone" aria-hidden="true"></i>
              <a href={`tel:${cv.basics.phoneHref}`} rel="nofollow noreferrer noopener">{cv.basics.phone}</a>
            </div>
            <div class="contact-item">
              <i class="fa-solid fa-envelope" aria-hidden="true"></i>
              <a href={`mailto:${cv.basics.email}`} rel="nofollow noreferrer noopener">{cv.basics.email}</a>
            </div>
            <div class="contact-item">
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
              <a href={cv.basics.webHref}>{cv.basics.web}</a>
            </div>
            <div class="contact-item">
              <i class="fa-brands fa-github" aria-hidden="true"></i>
              <a href={cv.basics.githubHref}>{cv.basics.github}</a>
            </div>
            <div class="contact-item">
              <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
              <a href={cv.basics.linkedinHref}>{cv.basics.linkedin}</a>
            </div>
            <div class="contact-item">
              <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
              <span>{t(cv.basics.location, locale)}</span>
            </div>
          </div>
        </header>

        <section class="content">
          <section class="section">
            <div class="section-title">
              <i class="fa-solid fa-user" aria-hidden="true"></i>
              <span>{t(cv.ui.profile, locale)}</span>
            </div>
            <div class="desc profile-desc">
              {cv.profile.map((paragraph) => <p>{t(paragraph, locale)}</p>)}
            </div>
          </section>

          <section class="section">
            <div class="section-title">
              <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
              <span>{t(cv.ui.education, locale)}</span>
            </div>
            <div>
              {cv.education.map((entry) => (
                <article class="entry">
                  <h3>{entry.institution}</h3>
                  <div class="place">{t(entry.program, locale)}</div>
                  <div class="meta">{t(entry.period, locale)}</div>
                  <div class="desc">{t(entry.description, locale)}</div>
                </article>
              ))}
            </div>
          </section>

          <section class="section">
            <div class="section-title">
              <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
              <span>{t(cv.ui.experience, locale)}</span>
            </div>
            <div>
              {cv.experience.map((entry) => (
                <article class="entry">
                  <h3>{t(entry.role, locale)}</h3>
                  <div class="place">{t(entry.place, locale)}</div>
                  <div class="meta">
                    <span>{t(entry.period, locale)}</span>
                    {'duration' in entry && (
                      <><span class="dot">•</span><span>{t(entry.duration, locale)}</span></>
                    )}
                  </div>
                  <div class="desc">{t(entry.description, locale)}</div>
                </article>
              ))}
            </div>
          </section>
        </section>
      </section>

      <section class="page page-two">
        <section class="content compact">
          <section class="section">
            <div class="section-title">
              <i class="fa-solid fa-laptop-code" aria-hidden="true"></i>
              <span>{t(cv.ui.skills, locale)}</span>
            </div>
            <div>
              {cv.skills.map((category) => (
                <div class="skill-category">
                  <h3>{t(category.title, locale)}</h3>
                  <ul class="skill-list">
                    {category.items.map((item) => <li><strong>{t(item, locale)}</strong></li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>

          <section class="section">
            <div class="section-title">
              <i class="fa-solid fa-globe" aria-hidden="true"></i>
              <span>{t(cv.ui.languages, locale)}</span>
            </div>
            <div>
              {cv.languages.map((language) => (
                <div class="language-row">
                  <strong>{t(language.name, locale)}</strong>
                  <span class="dot">•</span>
                  <span>{t(language.level, locale)}</span>
                </div>
              ))}
            </div>
          </section>

          <section class="section">
            <div class="section-title">
              <i class="fa-solid fa-star" aria-hidden="true"></i>
              <span>{t(cv.ui.strengths, locale)}</span>
            </div>
            <ul class="simple-list">
              {cv.strengths.map((strength) => <li>{t(strength, locale)}</li>)}
            </ul>
          </section>
        </section>
      </section>
    </main>

    <script is:inline>
      function printCv() {
        window.focus();
        setTimeout(() => window.print(), 100);
      }

      document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('printButton')?.addEventListener('click', printCv);
        document.addEventListener('keydown', (event) => {
          if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'p') {
            event.preventDefault();
            printCv();
          }
        });
      });
    </script>
  </body>
</html>
